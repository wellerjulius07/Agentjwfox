# Copy to .env and fill in. Personal machine only - never commit .env.

# Jarvis + the brain's ask-bar (sample capability)
ANTHROPIC_API_KEY=sk-ant-...

# Todoist: Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=

# Google Calendar OAuth (desktop app credentials from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Roots Jarvis is allowed to touch (semicolon-separated, Windows paths fine)
JARVIS_WATCH_DOWNLOADS=C:\Users\me\Downloads
JARVIS_ABLAGE_ROOT=C:\Users\me\OneDrive
